<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- LOCAL PATCH: the process code page is UTF-8 (Windows 10 1903+), so narrow paths (std::filesystem::path::string(),
     fopen, argv) carry any character. Without it a game folder like C:\Users\José\Games broke: .string() threw or
     gave '?', and the UTF-8 conversions the launcher does for CreateProcessW did not match. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
