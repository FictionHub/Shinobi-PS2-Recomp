+// LOCAL PATCH (Shinobi bridge): there is no VM in the bridge, so VMManager::GetDiscSerial() is empty and replacement
+// would switch itself off. The host passes the serial instead (RRV_PCSX2_GS_TEXTURE_SERIAL, e.g. SLUS-20459).
+static std::string BridgeDiscSerial()
+{
+	std::string serial = VMManager::GetDiscSerial();
+	if (serial.empty())
+		if (const char* env = std::getenv("RRV_PCSX2_GS_TEXTURE_SERIAL"); env && env[0] != '\0')
+			serial = env;
+	return serial;
+}
